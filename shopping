<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minimalist Shop</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header & Navigation -->
    <header>
        <div class="logo">SwiftShop</div>
        <nav>
            <button id="cart-btn">🛒 Cart (<span id="cart-count">0</span>)</button>
        </nav>
    </header>

    <!-- Main Product Grid -->
    <main>
        <h1 class="section-title">Our Products</h1>
        <div class="product-grid" id="product-list">
            <!-- Products will be generated dynamically by JavaScript -->
        </div>
    </main>

    <!-- Side Cart Drawer -->
    <div id="cart-drawer" class="cart-drawer">
        <div class="cart-header">
            <h2>Your Cart</h2>
            <button id="close-cart">&times;</button>
        </div>
        <div id="cart-items" class="cart-items">
            <!-- Cart items will appear here -->
        </div>
        <div class="cart-footer">
            <h3>Total: $<span id="cart-total">0.00</span></h3>
            <button class="checkout-btn" onclick="alert('Proceeding to checkout!')">Checkout</button>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
